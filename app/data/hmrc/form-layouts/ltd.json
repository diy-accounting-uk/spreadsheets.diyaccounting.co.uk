  "refShapes": {
    "box": "ct600-v3.toml [[box]] number",
    "line": "ct-computation-v1.1.toml <section>.<part>/<label>, split at the first slash",
    "heading": "frs105-formats.toml <statement>/<format or ->/<letter>"
