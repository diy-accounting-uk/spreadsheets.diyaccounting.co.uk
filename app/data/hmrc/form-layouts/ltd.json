  "forms": {
    "accounts": {
      "title": "Accounts",
      "microcopy": "Check these against the accounts you file. Headings follow the micro-entity formats; nothing here is a Companies House document.",
      "source": "accounts",
      "defaultFormat": "pence",
      "sections": [
        {
          "heading": "Balance sheet",
          "twoYear": true,
          "priorYearNote": "The prior-year column stays blank until the comparatives are entered on the opening balance sheet.",
          "rows": [
            {
              "heading": "balance-sheet/1/A",
              "empty": true,
              "note": "The template carries no figure for this heading."
            },
            {
              "heading": "balance-sheet/1/B"
            },
            {
              "heading": "balance-sheet/1/C"
            },
            {
              "heading": "balance-sheet/1/D",
              "empty": true,
              "note": "The template carries no figure for this heading."
            },
            {
              "heading": "balance-sheet/1/E"
            },
            {
              "heading": "balance-sheet/1/F"
            },
            {
              "heading": "balance-sheet/1/G"
            },
            {
              "heading": "balance-sheet/1/H"
            },
            {
              "heading": "balance-sheet/1/I",
              "empty": true,
              "note": "The template carries no figure for this heading."
            },
            {
              "heading": "balance-sheet/1/J",
              "empty": true,
              "note": "The template carries no figure for this heading."
            },
            {
              "heading": "balance-sheet/1/K",
              "total": true
            }
          ]
        },
        {
          "heading": "Profit and loss account",
          "twoYear": true,
          "priorYearNote": "Only turnover carries a prior-year figure. The sheet's prior-year cost of sales holds the materials line alone and its subcontractors line is not read, so that column stays blank rather than showing a short total.",
          "rows": [
            {
              "heading": "profit-and-loss/-/A",
              "priorCell": "Financialaccounts.xlsx!PubP&L!B9"
            },
            {
              "heading": "profit-and-loss/-/B",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!CorporationTax!K24"],
                "why": "other income is the gross bank interest; PubP&L!F48 holds the same figure but is not a read, and the working sheet's K24 is"
              }
            },
            {
              "heading": "profit-and-loss/-/C"
            },
            {
              "heading": "profit-and-loss/-/D",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!MnthP&L!B18", "Financialaccounts.xlsx!MnthP&L!B19", "Financialaccounts.xlsx!MnthP&L!B20"],
                "why": "the published account folds wages, directors' wages and employers' NI into one administrative expenses total, so the three staff lines come from the management sheet"
              }
            },
            {
              "heading": "profit-and-loss/-/E",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!MnthP&L!B39", "Financialaccounts.xlsx!MnthP&L!B40"],
                "why": "loss on disposal and depreciation, the two amounts written off assets the management sheet separates"
              }
            },
            {
              "heading": "profit-and-loss/-/F",
              "rule": {
                "op": "deduct",
                "cells": [
                  "Financialaccounts.xlsx!PubP&L!F44",
                  "Financialaccounts.xlsx!MnthP&L!B18",
                  "Financialaccounts.xlsx!MnthP&L!B19",
                  "Financialaccounts.xlsx!MnthP&L!B20",
                  "Financialaccounts.xlsx!MnthP&L!B39",
                  "Financialaccounts.xlsx!MnthP&L!B40"
                ],
                "why": "administrative expenses less the staff costs and the amounts written off assets already printed above; goodwill written off stays here"
              }
            },
            {
              "heading": "profit-and-loss/-/G"
            },
            {
              "heading": "profit-and-loss/-/H",
              "total": true
            }
          ]
        },
        {
          "heading": "Statements above the signature",
          "statements": [
            "These accounts have been prepared in accordance with the provisions applicable to companies subject to the micro-entities regime.",
            "For the year ending {periodEnd} the company was entitled to exemption from audit under section 477 of the Companies Act 2006 relating to small companies.",
            "The members have not required the company to obtain an audit of its accounts for the year in question in accordance with section 476 of the Companies Act 2006.",
            "The directors acknowledge their responsibilities for complying with the requirements of the Act with respect to accounting records and the preparation of accounts.",
            "Signed on behalf of the board by {directorName}, director."
          ]
        }
      ]
    },
    "computation": {
      "title": "Corporation tax computation",
      "microcopy": "Check these against the computation you file. The order follows HMRC's prescribed computation format; nothing here is an HMRC document. The bank interest shows twice on purpose: taken out of the accounting profit above, then added back as income of its own below.",
      "source": "computation",
      "defaultFormat": "pence",
      "sections": [
        {
          "heading": "Profit before tax",
          "rows": [
            {
              "line": "1.1/Profit/(loss) before tax per statutory accounts"
            }
          ]
        },
        {
          "heading": "Income deducted that is not trading income",
          "rows": [
            {
              "line": "1.2/Non-trading loan relationship credit",
              "deduct": true
            }
          ]
        },
        {
          "heading": "Disallowable expenditure added back",
          "rows": [
            {
              "line": "1.3/Depreciation"
            },
            {
              "line": "1.3/Trading debits in respect of intangible fixed assets"
            },
            {
              "line": "1.3/Donations",
              "outsideTotal": true,
              "note": "The working sheet does not add charitable donations back. The figure is shown for checking and is not in the total below."
            }
          ]
        },
        {
          "heading": "Adjusted profit",
          "rows": [
            {
              "line": "1.1/Adjusted Profit/(Loss)",
              "total": true
            }
          ]
        },
        {
          "heading": "Capital allowances, main pool",
          "rows": [
            {
              "line": "2.2d/AIA claimed",
              "cell": "Financialaccounts.xlsx!CorporationTax!I15"
            },
            {
              "line": "2.2d/WDA claimed",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!CorporationTax!I16", "Financialaccounts.xlsx!CorporationTax!I17"],
                "why": "the working sheet splits the writing-down allowance into cars bought in the year and assets held at the start; the main pool is one line"
              }
            },
            {
              "line": "2.2d/Balancing allowance",
              "rule": {
                "op": "sum",
                "cells": ["positivePartOf(Financialaccounts.xlsx!CorporationTax!I18)"],
                "why": "the working sheet's disposals line is signed: above nil it is a balancing allowance, which its allowances total adds"
              }
            },
            {
              "line": "2.2d/Balancing charge",
              "rule": {
                "op": "sum",
                "cells": ["negativePartOf(Financialaccounts.xlsx!CorporationTax!I18)"],
                "why": "below nil the same line is a balancing charge, carried as a negative allowance so the allowances total nets it off"
              }
            },
            {
              "line": "2.1/Total Capital Allowances",
              "deduct": true,
              "total": true
            }
          ]
        },
        {
          "heading": "Trading profit and taxable total profits",
          "note": "Version 1.1 of the prescribed format stops at the capital allowances. These lines carry the CT600 box they land in instead.",
          "rows": [
            {
              "label": "Trading profit after capital allowances",
              "cell": "Financialaccounts.xlsx!CorporationTax!K22",
              "ct600Box": 155
            },
            {
              "label": "Bank interest and other non-trading loan relationship profits",
              "cell": "Financialaccounts.xlsx!CorporationTax!K24",
              "ct600Box": 170,
              "note": "The same interest taken out of the accounting profit above, added back as income of its own."
            },
            {
              "label": "Trading losses brought forward",
              "cell": "Financialaccounts.xlsx!CorporationTax!K26",
              "ct600Box": 160,
              "deduct": true
            },
            {
              "label": "Profits chargeable to corporation tax",
              "cell": "Financialaccounts.xlsx!CorporationTax!K28",
              "ct600Box": 315,
              "total": true
            }
          ]
        },
        {
          "heading": "Tax",
          "rows": [
            {
              "group": "financial-year",
              "caption": "First financial year",
              "rows": [
                {
                  "label": "Financial year",
                  "format": "year",
                  "cell": "Financialaccounts.xlsx!CorporationTax!E33",
                  "ct600Box": 330
                },
                {
                  "label": "Profit",
                  "cell": "Financialaccounts.xlsx!CorporationTax!F33",
                  "ct600Box": 335
                },
                {
                  "label": "Rate of tax",
                  "format": "percent",
                  "cell": "Financialaccounts.xlsx!CorporationTax!G33",
                  "ct600Box": 340
                },
                {
                  "label": "Tax",
                  "cell": "Financialaccounts.xlsx!CorporationTax!J33",
                  "ct600Box": 345
                },
                {
                  "label": "Marginal relief",
                  "cell": "Financialaccounts.xlsx!CorporationTax!L33"
                },
                {
                  "label": "Tax after marginal relief",
                  "cell": "Financialaccounts.xlsx!CorporationTax!I33"
                }
              ]
            },
            {
              "group": "financial-year",
              "caption": "Second financial year",
              "blankWhen": "Financialaccounts.xlsx!CorporationTax!A34",
              "blankNote": "The period sits inside one financial year, so this group stays blank.",
              "rows": [
                {
                  "label": "Financial year",
                  "format": "year",
                  "cell": "Financialaccounts.xlsx!CorporationTax!E34",
                  "ct600Box": 380
                },
                {
                  "label": "Profit",
                  "cell": "Financialaccounts.xlsx!CorporationTax!F34",
                  "ct600Box": 385
                },
                {
                  "label": "Rate of tax",
                  "format": "percent",
                  "cell": "Financialaccounts.xlsx!CorporationTax!G34",
                  "ct600Box": 390
                },
                {
                  "label": "Tax",
                  "cell": "Financialaccounts.xlsx!CorporationTax!J34",
                  "ct600Box": 395
                },
                {
                  "label": "Marginal relief",
                  "cell": "Financialaccounts.xlsx!CorporationTax!L34"
                },
                {
                  "label": "Tax after marginal relief",
                  "cell": "Financialaccounts.xlsx!CorporationTax!I34"
                }
              ]
            },
            {
              "label": "Corporation tax chargeable",
              "cell": "Financialaccounts.xlsx!CorporationTax!K35",
              "ct600Box": 440,
              "total": true
            }
          ]
        }
      ]
    },
    "ct600": {
      "title": "CT600",
      "microcopy": "Check these against your return. Box numbers are the 2026 Version 3 form's; nothing here is an HMRC document.",
