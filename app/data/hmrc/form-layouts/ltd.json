    "accounts": {
      "title": "Accounts",
      "microcopy": "Check these against the accounts you file. Headings follow the micro-entity formats; nothing here is a Companies House document.",
      "source": "accounts",
      "sections": [
        {
          "heading": "Balance sheet",
          "twoYear": true,
          "rows": [
            {
              "heading": "balance-sheet/1/A"
            },
            {
              "heading": "balance-sheet/1/B"
            },
            {
              "heading": "balance-sheet/1/C"
            },
            {
              "heading": "balance-sheet/1/D"
            },
            {
              "heading": "balance-sheet/1/E"
            },
            {
              "heading": "balance-sheet/1/F"
            },
            {
              "heading": "balance-sheet/1/G"
            },
            {
              "heading": "balance-sheet/1/H"
            },
            {
              "heading": "balance-sheet/1/I"
            },
            {
              "heading": "balance-sheet/1/J"
            },
            {
              "heading": "balance-sheet/1/K",
              "total": true
            }
          ],
          "priorYearNote": "The prior-year column stays blank until the comparatives are entered on the opening balance sheet."
        },
        {
          "heading": "Profit and loss account",
          "twoYear": true,
          "rows": [
            {
              "heading": "profit-and-loss/-/A",
              "priorCell": "Financialaccounts.xlsx!PubP&L!B9"
            },
            {
              "heading": "profit-and-loss/-/B",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!CorporationTax!K24"],
                "why": "other income is the gross bank interest; PubP&L!F48 holds it but is not a read, and the working sheet's K24 is the same figure"
              }
            },
            {
              "heading": "profit-and-loss/-/C",
              "priorCell": "Financialaccounts.xlsx!PubP&L!B14"
            },
            {
              "heading": "profit-and-loss/-/D",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!MnthP&L!B18", "Financialaccounts.xlsx!MnthP&L!B19", "Financialaccounts.xlsx!MnthP&L!B20"],
                "why": "the published P&L folds wages, directors' wages and employers' NI into one administrative expenses total, so the three lines come from the management sheet"
              }
            },
            {
              "heading": "profit-and-loss/-/E",
              "rule": {
                "op": "sum",
                "cells": ["Financialaccounts.xlsx!MnthP&L!B39", "Financialaccounts.xlsx!MnthP&L!B40"],
                "why": "loss on disposal and depreciation, the two amounts written off assets the management sheet separates"
              }
            },
            {
              "heading": "profit-and-loss/-/F",
              "rule": {
                "op": "deduct",
                "cells": [
                  "Financialaccounts.xlsx!PubP&L!F44",
                  "Financialaccounts.xlsx!MnthP&L!B18",
                  "Financialaccounts.xlsx!MnthP&L!B19",
                  "Financialaccounts.xlsx!MnthP&L!B20",
                  "Financialaccounts.xlsx!MnthP&L!B39",
                  "Financialaccounts.xlsx!MnthP&L!B40"
                ],
                "why": "administrative expenses less the staff costs and the amounts written off assets already printed above; goodwill written off stays here"
              }
            },
            {
              "heading": "profit-and-loss/-/G"
            },
            {
              "heading": "profit-and-loss/-/H",
              "total": true
            }
          ],
          "priorYearNote": "Only turnover and cost of sales carry a prior-year figure; the rest stay blank until the comparatives are entered."
        },
        {
          "heading": "Statements above the signature",
          "rows": [
            {
              "text": "These accounts have been prepared in accordance with the provisions applicable to companies subject to the micro-entities regime."
            },
            {
              "text": "For the year ending {periodEnd} the company was entitled to exemption from audit under section 477 of the Companies Act 2006 relating to small companies."
            },
            {
              "text": "The members have not required the company to obtain an audit of its accounts for the year in question in accordance with section 476 of the Companies Act 2006."
            },
            {
              "text": "The directors acknowledge their responsibilities for complying with the requirements of the Act with respect to accounting records and the preparation of accounts."
            },
            {
              "text": "Signed on behalf of the board by {directorName}, director.",
              "from": "book"
            }
          ]
        }
      ]
    },
    "computation": {
      "title": "Corporation tax computation",
      "microcopy": "Check these against the computation you file. The order follows HMRC's prescribed computation format; nothing here is an HMRC document.",
      "source": "computation",
      "sections": [
        {
          "heading": "Profit before tax",
          "rows": [
