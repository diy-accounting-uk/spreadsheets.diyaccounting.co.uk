#
# pre-push — run the test router over everything this push adds to the remote.
#
# Push is the one chokepoint every branch crosses on its way to CI, and it is
# where the scope has to be the branch's whole diff rather than whatever was
# last edited. The base is the remote's current tip for the branch, so the
# router sees exactly the commits the remote is about to gain. A brand new
# branch, or a base this clone cannot resolve, falls back to origin/main, and
# the router escalates to the full set when even that fails.
#
# SKIP_LIBREOFFICE is cleared: the debug-loop escape hatch does not reach the
# push gate.
#
# In a hurry: SKIP_PUSH_TESTS=1 git push runs the gates tier alone, about two
# minutes, and prints what it did not run. It is there so the fast path is a
# recorded partial run rather than --no-verify, which runs nothing and says
# nothing.
#
# Before any of that: if the router already left a GREEN marker for the
# exact tree being pushed (target/test-scope/green-<tree-hash>, written by
# a prior `npm test` run against a base at or behind this push's own base),
# the run below is skipped outright — a suite that just passed is not
# repeated for the push that follows it.

set -uo pipefail

ZERO="0000000000000000000000000000000000000000"
base=""
pushing_commits=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  pushing_commits=1
  if [ -n "${remote_sha:-}" ] && [ "$remote_sha" != "$ZERO" ] && git rev-parse --verify --quiet "${remote_sha}^{commit}" >/dev/null; then
    base="$remote_sha"
  fi
  break
done

if [ "$pushing_commits" = "0" ]; then
  echo "pre-push: this push only deletes refs, so there is nothing to test."
  exit 0
fi

if [ -z "$base" ]; then
  base="origin/main"
fi

# NEXT.md is maintained on main alone (the docs exception in ../CLAUDE.md
# lands board edits there directly), so a branch that carries a NEXT.md
# change against main is always a stale or reverted board, never a real
# edit owed to this branch. PR #117 opened CONFLICTING on 2026-09-15
# because a squash carried the fork point's NEXT.md onto the batch branch,
# reverting two board edits; 72 job-minutes ran on the abandoned head.
# Checked before the Markdown-only fast path below, because a branch
# carrying only a NEXT.md change is exactly the case that path would
# otherwise wave through.
if [ "$remote_ref" != "refs/heads/main" ]; then
  if next_diff=$(git diff --name-only "origin/main...${local_sha}" -- NEXT.md 2>/dev/null) && [ -n "$next_diff" ]; then
    echo "pre-push: NEXT.md is maintained on main; drop it from this branch: git checkout origin/main -- NEXT.md && git commit"
    exit 1
  fi
fi

# A push whose every path is Markdown has nothing for the router: the docs
# exception in ../CLAUDE.md sends .md-only commits straight to main, and no
# tier reads a .md file. Measured 2026-09-14: twelve such pushes in one
# session, about 21 seconds of gates tier each. An empty diff falls through
# to the router, which escalates on it rather than hiding it.
if diff_output=$(git diff --name-only "${base}...${local_sha}" 2>/dev/null) || \
   diff_output=$(git diff --name-only "${base}" "${local_sha}" 2>/dev/null); then
  if [ -n "$diff_output" ] && ! echo "$diff_output" | grep -v '\.md$' >/dev/null; then
    md_count=$(echo "$diff_output" | grep -c .)
    echo "pre-push: every path this push adds is Markdown (${md_count} files); nothing to test."
    exit 0
  fi
fi

# A GREEN marker vouches for this push only if it was written for the exact
# tree being pushed (local_sha's own committed tree, not this worktree's
# possibly-dirty one) AND its recorded base is this push's own merge base
# (or the marker was a full --all/escalated pass, recorded as "ALL"). A
# marker from a narrower or differently-based run never counts.
#
# The hash comes from the router itself (--tree-hash --rev), not a plain
# `git rev-parse ...^{tree}`: the router blanks provenance-data.js's
# engineVersion value first, so a commit that only restamps that field
# after the tested commit still hashes the same as the tree the marker was
# written for.
tree_hash="$(node scripts/test-scope.mjs --tree-hash --rev "${local_sha}" 2>/dev/null || true)"
marker=""
if [ -n "$tree_hash" ] && [ -f "target/test-scope/green-${tree_hash}" ]; then
  marker="target/test-scope/green-${tree_hash}"
fi

if [ -n "$marker" ]; then
  marker_base="$(sed -n 's/^mergeBase=\([^ ]*\).*/\1/p' "$marker")"
  marker_tiers="$(sed -n 's/.*tiers=\([^ ]*\).*/\1/p' "$marker")"
  marker_at="$(sed -n 's/.*at=\([^ ]*\).*/\1/p' "$marker")"
  push_merge_base="$(git merge-base "$local_sha" "$base" 2>/dev/null || true)"
  match=0
  if [ "$marker_base" = "ALL" ]; then
    match=1
  elif [ -n "$push_merge_base" ] && [ "$marker_base" = "$push_merge_base" ]; then
    match=1
  fi
  if [ "$match" = "1" ]; then
    echo "pre-push: tree ${tree_hash} passed GREEN at ${marker_at} (base ${marker_base}, tiers ${marker_tiers}); skipping the run."
    exit 0
  fi
  echo "pre-push: a GREEN marker exists for tree ${tree_hash} but its base (${marker_base}) does not cover this push's base (${push_merge_base:-unresolved}); running anyway."
fi

unset SKIP_LIBREOFFICE
# git exports GIT_DIR (and on some paths GIT_WORK_TREE and GIT_INDEX_FILE) to a hook. A
# test that runs `git init` in a temporary directory then re-initialises THIS repository
# and commits onto the pushed branch. Measured 2026-09-14: the archive-packages tests
# under this hook turned the checkout bare and put four "Test" commits on the batch.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX

if [ "${SKIP_PUSH_TESTS:-}" = "1" ]; then
  echo "pre-push: SKIP_PUSH_TESTS=1, running the gates tier only."
  echo "pre-push: the unit, calc, browser and infra tiers are NOT running. CI is now the first thing that will see them."
  TEST_SCOPE_TIERS=gates node scripts/test-scope.mjs --base "$base"
  exit $?
fi

echo "pre-push: routing the tests over everything this push adds, base ${base}."
node scripts/test-scope.mjs --base "$base"
