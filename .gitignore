# Generated diagrams
*.drawio
*.svg

# Generated spreadsheets redirect function (built from redirects.toml by scripts/build-spreadsheets-redirects.cjs)
web/spreadsheets.diyaccounting.co.uk/redirect-function.js

# Generated data files (built by scripts)
web/spreadsheets.diyaccounting.co.uk/public/catalogue.toml
web/spreadsheets.diyaccounting.co.uk/public/sitemap.xml
web/spreadsheets.diyaccounting.co.uk/public/knowledge-base.toml

# Generated donate page (built per environment from donate.template.html
# and donate-links.toml by scripts/build-donate-page.mjs)
web/spreadsheets.diyaccounting.co.uk/public/donate.html

# Files scripts/build-diya-gl-bundle.mjs and scripts/build-donate-page.mjs
# copy or generate into the diya-gl.co.uk site root: the DIYA-GL donation
# config, the books engine bundle and its assets, the two published JSON
# Schemas, the copied spreadsheets-site files its CSP forbids fetching
# cross-origin, and the redirect function and sitemap the site's own
# builders write
web/diya-gl.co.uk/public/donate-config.js
web/diya-gl.co.uk/public/engine/
web/diya-gl.co.uk/public/assets/
web/diya-gl.co.uk/public/examples.js
web/diya-gl.co.uk/public/build-stamp.js
web/diya-gl.co.uk/public/schema/
web/diya-gl.co.uk/public/lib/
web/diya-gl.co.uk/public/spreadsheets.css
web/diya-gl.co.uk/public/favicon.*
web/diya-gl.co.uk/public/sitemap.xml
web/diya-gl.co.uk/redirect-function.js

# Generated zip packages
target/zips/

# Symlink for local dev (points to target/zips/)
web/spreadsheets.diyaccounting.co.uk/public/zips

# Test output and reports
web/spreadsheets.diyaccounting.co.uk/public/tests/
reports/populated/
reports/screenshots/
*.log
.scratch/

# Judge verdicts are written per run; CI attaches them as artefacts.
reports/judge-verdict-*.json

.claude/worktrees/

# diya-gl package: files copied into place by diya-gl/scripts/prepack.mjs, its
